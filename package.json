{
  "name": "ecom-custom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run dev -w @ecom/api",
    "dev:web": "npm run dev -w @ecom/storefront",
    "build": "npm run build -w @ecom/api && npm run build -w @ecom/storefront",
    "start": "npm-run-all --parallel start:api start:web",
    "start:api": "npm run start -w @ecom/api",
    "start:web": "npm run start -w @ecom/storefront",
    "db:generate": "npm run generate -w @ecom/db",
    "db:migrate": "npm run migrate -w @ecom/db",
    "db:seed": "npm run seed -w @ecom/db",
    "db:reset": "npm run reset -w @ecom/db",
    "setup": "npm install && npm run db:migrate && npm run db:seed",
    "typecheck": "tsc -b --pretty"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
