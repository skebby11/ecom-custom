# ─────────────────────────────────────────────────────────────
# Copia questo file in `.env` (`cp .env.example .env`) e compila.
# Il file `.env` è ignorato da git: non committarlo mai.
# ─────────────────────────────────────────────────────────────

# Database ---------------------------------------------------
# Percorso del file SQLite, relativo alla root del monorepo.
DATABASE_URL=./data/ecom.db

# API --------------------------------------------------------
API_PORT=3001
API_HOST=0.0.0.0
# Origine del sito pubblico, usata per CORS e per i redirect Stripe.
PUBLIC_SITE_URL=http://localhost:4321
# Segreto per firmare i cookie di sessione admin.
# Genera con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia-questo-valore-con-una-stringa-random-di-64-caratteri

# Storefront -------------------------------------------------
# URL dell'API visto dal server Astro (SSR, rete interna).
API_URL=http://localhost:3001
# URL dell'API visto dal browser (chiamate client-side del carrello).
PUBLIC_API_URL=http://localhost:3001
PUBLIC_SITE_NAME="Ecom Custom"

# Admin di bootstrap (creato da `npm run db:seed`) -------------
# Obbligatorie: senza, il seed si rifiuta di creare l'utente amministratore.
# La password qui sotto va bene solo in locale: cambiala prima di qualsiasi
# ambiente raggiungibile da fuori (il seed la rifiuta se NODE_ENV=production).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# Stripe (modalità test/sandbox) ------------------------------
# Chiavi test da https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Segreto webhook. In locale: `stripe listen --forward-to localhost:3001/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_xxx
