# ─────────────────────────────────────────────────────────────
# Copia questo file in `.env` (`cp .env.example .env`) e compila.
# Il file `.env` è ignorato da git: non committarlo mai.
# ─────────────────────────────────────────────────────────────

# Ambiente ---------------------------------------------------
# `development` abilita gli script distruttivi `db:reset` e `db:seed`, che
# ricreano il catalogo e svuotano i carrelli attivi. In produzione va
# `production`: le immagini Docker lo impostano già da sé, e una variabile
# dell'ambiente reale ha comunque la precedenza su questo file.
NODE_ENV=development

# Database ---------------------------------------------------
# Percorso del file SQLite, relativo alla root del monorepo.
DATABASE_URL=./data/ecom.db

# API --------------------------------------------------------
API_PORT=3001
API_HOST=0.0.0.0
# Origine del sito pubblico, usata per CORS e per i redirect Stripe. In
# produzione è anche un build arg dell'immagine storefront (vedi
# docker-compose.yml): astro.config.mjs rifiuta il build se manca.
PUBLIC_SITE_URL=http://localhost:4321

# Storefront -------------------------------------------------
# URL dell'API visto dal server Astro (SSR, rete interna).
API_URL=http://localhost:3001
# URL dell'API visto dal browser (chiamate client-side del carrello).
PUBLIC_API_URL=http://localhost:3001
PUBLIC_SITE_NAME="Ecom Custom"

# Admin di bootstrap (creato da `npm run db:seed`) -------------
# Entrambe obbligatorie: senza, il seed si rifiuta di creare l'utente.
# ADMIN_PASSWORD è volutamente vuota. Una password funzionante nel template
# finisce copiata in produzione insieme al file: scegline una tu, minimo 8
# caratteri. Fuori da NODE_ENV=development il seed rifiuta anche le password
# di esempio note, e `--force` non aggira il controllo.
# Genera con:  node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Stripe (modalità test/sandbox) ------------------------------
# Chiavi test da https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Segreto webhook. In locale: `stripe listen --forward-to localhost:3001/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_xxx
