---
import AdminLayout from '~/layouts/AdminLayout.astro'
import StatusBadge from '~/components/admin/StatusBadge.astro'
import { requireSession, getStats, listOrders } from '~/lib/admin-api'
import { formatPrice } from '@ecom/shared/format'

const session = await requireSession(Astro)
if (session instanceof Response) return session
const user = session

const [stats, recentOrders] = await Promise.all([
  getStats(Astro.request),
  listOrders(Astro.request, { page: 1, limit: 5 }),
])

const cards = [
  { label: 'Prodotti', value: String(stats.products) },
  { label: 'Ordini', value: String(stats.orders) },
  { label: 'Fatturato', value: formatPrice(stats.revenueCents) },
  { label: 'Ordini in attesa', value: String(stats.pendingOrders) },
]
---

<AdminLayout title="Dashboard" user={user}>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      cards.map((card) => (
        <div class="card p-4">
          <p class="text-xs font-medium tracking-wide text-muted uppercase">{card.label}</p>
          <p class="mt-1 text-2xl font-semibold text-ink">{card.value}</p>
        </div>
      ))
    }
  </div>

  <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-3">
    <section class="lg:col-span-2">
      <h2 class="mb-3 text-sm font-semibold text-ink">Ultimi ordini</h2>
      {
        recentOrders.items.length === 0 ? (
          <p class="text-sm text-muted">Nessun ordine ancora.</p>
        ) : (
          <div class="card overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead class="border-b border-line text-xs text-muted uppercase">
                <tr>
                  <th class="px-4 py-2 font-medium">Numero</th>
                  <th class="px-4 py-2 font-medium">Data</th>
                  <th class="px-4 py-2 font-medium">Email</th>
                  <th class="px-4 py-2 font-medium">Stato</th>
                  <th class="px-4 py-2 text-right font-medium">Totale</th>
                </tr>
              </thead>
              <tbody>
                {recentOrders.items.map((order) => (
                  <tr class="border-b border-line last:border-0">
                    <td class="px-4 py-2">
                      <a href={`/admin/ordini/${order.id}`} class="font-medium text-brand-700 hover:underline">
                        {order.number}
                      </a>
                    </td>
                    <td class="px-4 py-2 text-muted">
                      {new Date(order.createdAt).toLocaleDateString('it-IT', { timeZone: 'Europe/Rome' })}
                    </td>
                    <td class="px-4 py-2">{order.email}</td>
                    <td class="px-4 py-2">
                      <StatusBadge status={order.status} />
                    </td>
                    <td class="px-4 py-2 text-right">{formatPrice(order.totalCents)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
      <div class="mt-3 text-right">
        <a href="/admin/ordini" class="text-sm font-medium text-brand-700 hover:underline">
          Vedi tutti gli ordini →
        </a>
      </div>
    </section>

    <section>
      <h2 class="mb-3 text-sm font-semibold text-ink">Sotto scorta</h2>
      {
        stats.lowStock.length === 0 ? (
          <p class="text-sm text-muted">Nessuna variante sotto scorta.</p>
        ) : (
          <div class="card divide-y divide-line">
            {stats.lowStock.map((item) => (
              <div class="flex items-center justify-between gap-3 px-4 py-3 text-sm">
                <div class="min-w-0">
                  <a
                    href={`/admin/prodotti/${item.productId}`}
                    class="block truncate font-medium text-ink hover:underline"
                  >
                    {item.productTitle}
                  </a>
                  <p class="truncate text-xs text-muted">
                    {item.variantTitle} · {item.sku}
                  </p>
                </div>
                <span class="shrink-0 rounded-full bg-red-100 px-2.5 py-0.5 text-xs font-medium text-red-700">
                  {item.stock} pz
                </span>
              </div>
            ))}
          </div>
        )
      }
    </section>
  </div>
</AdminLayout>
