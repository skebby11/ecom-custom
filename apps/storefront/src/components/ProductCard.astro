---
import type { ProductListItem } from '@ecom/shared'
import { formatPrice } from '@ecom/shared/format'

export interface Props {
  product: ProductListItem
  /** true per le prime card sopra la piega: niente lazy-loading. */
  priority?: boolean
}

const { product, priority = false } = Astro.props
const hasDiscount = product.compareAtCents != null && product.compareAtCents > product.priceCents
---

<a
  href={`/p/${product.slug}`}
  class="card group flex flex-col overflow-hidden transition-shadow hover:shadow-md"
>
  <div class="relative aspect-square overflow-hidden bg-surface-alt">
    <img
      src={product.image?.url ?? '/placeholder-product.svg'}
      alt={product.image?.alt ?? product.title}
      width="600"
      height="600"
      loading={priority ? 'eager' : 'lazy'}
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
    {!product.inStock && (
      <span class="absolute left-2 top-2 rounded-full bg-ink/80 px-2.5 py-1 text-xs font-medium text-white">
        Esaurito
      </span>
    )}
  </div>
  <div class="flex flex-1 flex-col gap-1 p-4">
    <h3 class="text-sm font-medium text-ink">{product.title}</h3>
    {product.excerpt && (
      <p class="line-clamp-2 text-sm text-muted">{product.excerpt}</p>
    )}
    <div class="mt-auto flex items-baseline gap-2 pt-2">
      <span class="text-base font-semibold text-ink">{formatPrice(product.priceCents)}</span>
      {hasDiscount && (
        <span class="text-sm text-muted line-through">{formatPrice(product.compareAtCents!)}</span>
      )}
    </div>
  </div>
</a>
