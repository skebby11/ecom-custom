---
import type { Collection } from '@ecom/shared'

export interface Props {
  collection: Collection
  priority?: boolean
}

const { collection, priority = false } = Astro.props
---

<a
  href={`/catalogo/${collection.slug}`}
  class="card group relative flex aspect-[4/3] flex-col justify-end overflow-hidden"
>
  <img
    src={collection.imageUrl ?? '/placeholder-product.svg'}
    alt={collection.title}
    width="800"
    height="600"
    loading={priority ? 'eager' : 'lazy'}
    class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-ink/70 via-ink/10 to-transparent"></div>
  <div class="relative p-5 text-white">
    <h3 class="text-lg font-semibold">{collection.title}</h3>
    {collection.productCount != null && (
      <p class="text-sm text-white/80">{collection.productCount} prodotti</p>
    )}
  </div>
</a>
